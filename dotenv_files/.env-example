# ==================== DJANGO ====================
SECRET_KEY=seu-secret-key-super-secreto-aqui-mude-isso
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=project.settings
PYTHONUNBUFFERED=1

# ==================== DATABASE ====================
DB_NAME=automation_db
DB_USER=automation_user
DB_PASSWORD=automation_pass
DB_HOST=db
DB_PORT=5432

# ==================== REDIS & CELERY ====================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ==================== AI PROVIDER ====================
# Escolha UM dos providers abaixo ou use 'auto' para detecção automática
# auto = detecta automaticamente (Gemini > OpenAI > LM Studio)
AI_PROVIDER=auto

# Opção 1: Google Gemini (RECOMENDADO - Grátis!)
# Pegar em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyCy_GzFrCKOH01LlhOMBGfizspmRwzixe4
GEMINI_MODEL=gemini-2.5-flash

# Opção 2: OpenAI (Pago)
# Pegar em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Opção 3: LM Studio (Local - Requer software rodando)
OPENAI_BASE_URL=http://host.docker.internal:1234/v1

# ==================== TELEGRAM ====================
# Criar bot em: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_BOT_USERNAME=SeuBotUsername_bot

# Para desenvolvimento local com ngrok:
# TELEGRAM_WEBHOOK_URL=https://xxxx-xx-xxx-xxx-xx.ngrok-free.app/webhook/telegram/
# Para Railway (depois do deploy):
# TELEGRAM_WEBHOOK_URL=https://seu-app.up.railway.app/webhook/telegram/
TELEGRAM_WEBHOOK_URL=http://localhost:8000/webhook/telegram/

# ==================== NOTION (FUTURO) ====================
# Pegar em: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_...

